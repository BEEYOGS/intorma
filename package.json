{
  "name": "intorma-saas",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:uploads-to-drive": "tsx scripts/migrate-uploads-to-drive.ts",
    "db:drive-only": "node --env-file=.env.local scripts/migrate-drive-only.mjs",
    "db:self-service": "node --env-file=.env.local scripts/seed-self-service.mjs",
    "db:catalog": "node --env-file=.env.local scripts/seed-catalog.mjs",
    "db:catalog:all": "npm run db:catalog && npm run db:self-service",
    "db:wa-trigger": "node --env-file=.env.local scripts/migrate-wa-trigger.mjs",
    "db:admin-owner": "node --env-file=.env.local scripts/seed-admin-owner.mjs",
    "gateway": "node scripts/gateway.mjs",
    "openwa": "node scripts/openwa.mjs",
    "wa:session": "node scripts/wa-session.mjs",
    "wa:agent": "node scripts/wa-agent.mjs",
    "wa:webhook": "node scripts/wa-webhook.mjs",
    "wa:check": "node scripts/wa-check.mjs",
    "wa:fonnte:setup": "node scripts/setup-fonnte.mjs",
    "wa:cloud:setup": "node scripts/setup-meta-cloud.mjs",
    "wa:cloud:templates": "node scripts/meta-templates.mjs",
    "test:integrations": "tsx scripts/test-integrations.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "db:backup": "node --env-file=.env.local scripts/backup-db.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.3",
    "@capacitor/core": "^8.6.3",
    "@neondatabase/serverless": "^1.0.0",
    "lucide-react": "^1.79.0",
    "next": "^15.5.29",
    "pdfkit": "^0.21.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.15.3",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
