# Neon (Postgres) — ambil dari dashboard Neon, pakai connection string "pooled"
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# Admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_SECRET=string-acak-panjang-minimal-32-karakter

# Nomor WhatsApp publik untuk tautan chat (format bebas: 0812..., 62812..., +62...)
NEXT_PUBLIC_WA_NUMBER=6289617607952

# Nomor admin yang menerima notifikasi order baru
ADMIN_WA=089617607952

# URL publik situs (dipakai untuk link di pesan WA dan webhook OpenWA)
NEXT_PUBLIC_SITE_URL=https://intorma-psi.vercel.app

# OpenWA gateway (opsional; jalankan terpisah, lihat README)
# Di Vercel JANGAN isi OPENWA_URL dengan localhost. Notifikasi akan masuk
# wa_outbox dan dikirim oleh `npm run wa:agent` di komputer yang menjalankan OpenWA.
OPENWA_URL=http://127.0.0.1:2785
OPENWA_KEY=samakan-dengan-api-key-gateway
OPENWA_SESSION=intorma
OPENWA_WEBHOOK_SECRET=isi-string-acak

# Opsional: paksa semua pesan lewat antrean (berguna saat debugging)
# WA_QUEUE_ONLY=1
# WA_POLL_MS=5000
