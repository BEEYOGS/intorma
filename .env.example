# Neon (Postgres) - ambil dari dashboard Neon, pakai connection string "pooled"
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# Admin
ADMIN_PASSWORD=ganti-ini
ADMIN_SECRET=isi-string-acak-panjang

# OpenWA (server open-wa jalan terpisah, lihat README)
OPENWA_URL=http://localhost:8002
OPENWA_KEY=samakan-dengan---key-di-open-wa
OPENWA_WEBHOOK_SECRET=isi-string-acak
# Nomor WA kamu (menerima notifikasi order baru), format bebas: 0812... atau 62812...
ADMIN_WA=
# URL publik situs (dipakai untuk link di pesan WA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
