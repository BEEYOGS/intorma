# Neon Postgres — ambil dari dashboard Neon, pakai connection string "pooled"
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# Admin
# Fallback password ADMIN_PASSWORD sengaja dinonaktifkan (0). Akun admin database
# yang dipakai; jangan mengubahnya menjadi 1 di produksi.
ADMIN_PASSWORD_ENABLED=0
ADMIN_PASSWORD=
ADMIN_SECRET=string-acak-panjang-minimal-32-karakter
# Opsional: kunci khusus sesi portal klien. Kosongkan untuk memakai ADMIN_SECRET.
CUSTOMER_SECRET=
# Opsional: kunci khusus token upload langsung. Kosongkan untuk memakai ADMIN_SECRET.
UPLOAD_TOKEN_SECRET=

# App
# Wajib di production: melindungi /api/cron/reminders (Bearer <CRON_SECRET>)
CRON_SECRET=string-acak-panjang-minimal-32-karakter
NEXT_PUBLIC_SITE_URL=https://intorma-psi.vercel.app
# Nomor WhatsApp publik untuk tautan chat (format bebas: 0812..., 62812..., +62...)
# Isi dengan nomor bisnis milikmu; jangan commit nomor pribadi ke repo.
NEXT_PUBLIC_WA_NUMBER=
# Nomor admin penerima notifikasi order baru
ADMIN_WHATSAPP_NUMBER=

# WhatsApp — WA_PROVIDER=fonnte adalah jalur aktif produksi.
# Token dan webhook rahasia jangan pernah ditempel di chat atau commit.
WA_PROVIDER=fonnte
FONNTE_TOKEN=
# WA_WEBHOOK_SECRET memakai OPENWA_WEBHOOK_SECRET bila kosong. Webhook Fonnte:
# https://domain-kamu/api/wa/webhook/<WA_WEBHOOK_SECRET> (secret di path, bukan query)
WA_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API — OPSI, tidak otomatis mengganti Fonnte.
# Butuh verifikasi nomor & template yang disetujui Meta sebelum dipakai.
# WA_PROVIDER=cloud
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERSION=v25.0
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=
META_TPL_LANGUAGE=id
# Webhook Meta: https://domain-kamu/api/wa/webhook
# Template wajib dibuat & disetujui di Meta Business Manager dengan isi persis:
# order_created: Halo {{1}}, pesanan {{2}} sudah kami terima. | {{3}} | Total: {{4}} | Target selesai: {{5}} | Pantau & bayar: {{6}}
# admin_notice: Notifikasi in.torma — {{1}}: {{2}}
# order_status: Halo {{1}}, pesanan {{2}}: {{3}} | Pantau di: {{4}}
# payment_received: Halo {{1}}, pembayaran {{2}} sebesar {{3}} sudah kami terima. Terima kasih! | Pantau: {{4}}
# payment_reminder: Halo {{1}}, pesanan {{2}} masih menunggu pembayaran. | Total: {{3}} | Target selesai: {{4}} | Bayar & detail: {{5}}
# reorder_offer: Halo {{1}}, pesanan {{2}} sudah selesai. | Butuh cetak ulang? Pakai {{3}} untuk diskon. | Pesan lagi: {{4}}
# Nama template bisa diubah lewat META_TPL_ORDER, META_TPL_ADMIN, META_TPL_STATUS,
# META_TPL_PAYMENT, META_TPL_REMINDER, META_TPL_REORDER.

# OpenWA (self-hosted) — FALLBACK bila Fonnte/Cloud tidak dipakai.
# Di Vercel JANGAN isi OPENWA_BASE_URL/OPENWA_URL dengan localhost: notifikasi
# akan masuk wa_outbox dan dikirim oleh `npm run wa:agent` di mesin OpenWA.
# WA_PROVIDER=openwa
OPENWA_BASE_URL=https://wa-gateway-kamu.example.com
OPENWA_API_KEY=
OPENWA_SESSION=intorma
OPENWA_WEBHOOK_SECRET=
# Alias lama (masih dibaca kalau variabel baru kosong):
# OPENWA_URL=http://127.0.0.1:2785
# OPENWA_KEY=
# ADMIN_WA=

# Worker antrean WA outbox / jembatan publik untuk agent tanpa DB produksi.
# OUTBOX_URL, SITE_WEBHOOK_URL, dan WA_SITE_URL mengacu ke URL situs publik.
# WA_QUEUE_ONLY=1      # paksa semua pesan lewat antrean
# WA_POLL_MS=5000      # interval polling worker (ms)
# WA_WEBHOOK_URL=      # timpa URL webhook saat mendaftar ke OpenWA
# WA_INBOX_PORT=2786   # inbox lokal untuk balasan "status INT-..."
# WA_INBOX_SECRET=     # default: OPENWA_WEBHOOK_SECRET
# WA_OPEN_QR=0         # jangan buka viewer QR otomatis
# APP_PORT=3001        # port app untuk npm run gateway
# GATEWAY_VERBOSE=0    # log verbose untuk mode gateway lokal
# OPENWA_DIR=          # path instalasi OpenWA (default: ./openwa)
# OPENWA_DIST_MAIN=    # path entry OpenWA bila berbeda
# OPENWA_NODE=node     # binary node untuk gateway lokal
# OPENWA_PORT=2785     # port gateway lokal

# Google Drive sebagai penyimpanan file. Wajib diisi untuk fitur upload;
# file tidak pernah disimpan di database (Neon hanya metadata).
# Untuk Gmail/Drive pribadi WAJIB pakai OAuth user (service account tidak punya kuota):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Hanya untuk Shared Drive / Google Workspace:
GOOGLE_DRIVE_AUTH=oauth
GOOGLE_SERVICE_ACCOUNT_JSON=
# Service account JSON satu baris (Shared Drive/Workspace saja):
GDRIVE_SERVICE_ACCOUNT=
GDRIVE_FOLDER=

# Payment gateway Midtrans (opsional). Kosongkan untuk memakai transfer manual.
# Sandbox: https://dashboard.sandbox.midtrans.com  → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=0
# Khusus rotasi kunci tanda tangan Midtrans. Kosongkan untuk memakai SERVER_KEY.
MIDTRANS_SIGNATURE_SECRET_KEY=

# Dev-only: jangan set di production.
# ALLOW_LOCAL_CRON=1  # izinkan /api/cron/reminders tanpa CRON_SECRET di localhost

# Catatan: paket Fonnte tertentu masih menambahkan footer pihak ketiga dan
# tidak bisa dihapus lewat API. Gunakan paket yang mendukung pesan tanpa footer.
