# Neon Postgres
DATABASE_URL=postgresql://user:password@host.neon.tech/db?sslmode=require

# Admin (jangan commit; gunakan environment manager untuk produksi)
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_SECRET=string-acak-panjang-minimal-32-karakter
# Opsional: kunci khusus sesi portal klien. Kosongkan untuk memakai ADMIN_SECRET.
CUSTOMER_SECRET=string-acak-lain-minimal-32-karakter

# App
NEXT_PUBLIC_SITE_URL=https://intorma-psi.vercel.app
NEXT_PUBLIC_WA_NUMBER=6289617607952
ADMIN_WA=0895329940950

# Google Drive sebagai penyimpanan file (opsional). Kosongkan untuk simpan di database.
# Isi dengan seluruh isi file JSON service account (satu baris, escape newline sebagai \n).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Payment gateway Midtrans (opsional). Kosongkan untuk memakai transfer manual.
# Sandbox: https://dashboard.sandbox.midtrans.com  → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=0

# OpenWA optional
OPENWA_URL=http://127.0.0.1:2785
OPENWA_KEY=samakan-dengan-api-key-gateway
OPENWA_SESSION=intorma
OPENWA_WEBHOOK_SECRET=isi-string-acak
